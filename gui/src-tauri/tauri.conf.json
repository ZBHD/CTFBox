{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CTFBox",
  "version": "0.1.0",
  "identifier": "com.zbhd.ctfbox",
  "build": {
    "beforeDevCommand": "pnpm run dev:renderer",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CTFBox",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
