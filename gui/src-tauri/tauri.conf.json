{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CTFBox",
  "version": "0.1.3",
  "identifier": "com.zbhd.ctfbox",
  "build": {
    "beforeDevCommand": "pnpm run dev:renderer",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run prepare:runtime && pnpm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CTFBox",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "resources": {
      "../../Original": "Original",
      "../../CNversion": "CNversion",
      "../../tools/ctfbox_launcher.py": "tools/ctfbox_launcher.py",
      "../../tools/tool_registry.json": "tools/tool_registry.json",
      "resources/python": "python"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
